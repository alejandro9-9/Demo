# Admin credentials. Never commit the real values.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=scrypt$replace-with-a-generated-hash
SESSION_SECRET=replace-with-a-long-random-secret

# GitHub fine-grained token with Contents: Read and write on this repository.
GITHUB_TOKEN=github_pat_replace_me
GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=your-repository
GITHUB_BRANCH=main

# Optional localhost-only persistence when GitHub variables are intentionally empty.
# LOCAL_CONTENT_PATH=C:/ruta/al/proyecto/data/content.json
# LOCAL_UPLOAD_DIR=C:/ruta/al/proyecto/public/uploads
